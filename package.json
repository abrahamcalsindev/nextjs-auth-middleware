{
  "name": "nextjs-auth-middleware",
  "version": "1.0.0",
  "private": false,
  "description": "Nextjs-Auth-Middleware is a node.js package that provides middleware that can be used to add API Key authentications to secure an API route in Next.js.",
  "keywords": [
    "nextjs-auth-middleware",
    "next-auth",
    "nextjs",
    "api-key",
    "middleware"
  ],
  "homepage": "https://github.com/abrahamcalsindev/nextjs-auth-middleware#readme",
  "bugs": {
    "url": "https://github.com/abrahamcalsindev/nextjs-auth-middleware/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abrahamcalsindev/nextjs-auth-middleware.git"
  },
  "license": "MIT",
  "author": "abrahamcalsindev",
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsup src/index.ts --format cjs,esm --dts --minify --treeshake --target node20",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci --coverage --maxWorkers=2",
    "lint": "tsc --noEmit",
    "prepare": "npm run build",
    "size": "size-limit",
    "analyze": "size-limit --why"
  },
  "peerDependencies": {
    "next": ">=12 <17"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "jest": "^29.7.0",
    "next": "16.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^5.0.5",
    "size-limit": "^11.1.0",
    "ts-jest": "^29.1.1",
    "tslib": "^2.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.5.0"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "3 KB"
    },
    {
      "path": "dist/index.mjs",
      "limit": "3 KB"
    }
  ]
}
